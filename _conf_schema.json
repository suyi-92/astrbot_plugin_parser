{
    "whitelist": {
        "description": "解析白名单",
        "hint": "请填写会话ID (可用命令sid查看), 一旦添加了白名单，则只有白名单会话发的链接会触发解析，优先级比黑名单高。留空表示不限制",
        "type": "list",
        "default": []
    },
    "blacklist": {
        "description": "解析黑名单",
        "hint": "请填写会话ID (可用命令sid查看), 黑名单会话发的链接不会触发解析。可在会话中使用命令 “开启解析” 和 “关闭解析” 来快捷设置",
        "type": "list",
        "default": []
    },
    "arbiter": {
        "description": "仲裁机制",
        "hint": "仲裁机制：一个确保群内只有一个 Bot 对链接进行解析的机制，利用 QQ 贴表情来实现。 注意：此开关无效，所有插件使用者强制启用仲裁机制，以确保所有 Bot 遵循本插件的仲裁协议",
        "type": "bool",
        "default": true
    },
    "require_at_in_group": {
        "description": "群组消息必须@机器人",
        "hint": "非支持仲裁的平台群组中，只有@机器人的消息才会触发解析",
        "type": "bool",
        "default": true
    },
    "enable_reply_parse": {
        "description": "引用消息解析",
        "hint": "开启后，可通过引用包含链接的消息触发解析",
        "type": "bool",
        "default": false
    },
    "debounce_interval": {
        "description": "防抖秒数",
        "hint": "防抖机制：同一个会话下，防抖时间内不解析那些已经解析过的链接。设为 0 表示不启用防抖机制",
        "type": "int",
        "slider": {
            "min": 0,
            "max": 600,
            "step": 10
        },
        "default": 300
    },
    "source_max_size": {
        "description": "资源最大大小",
        "hint": "允许下载的音视频最大体积，单位 MB",
        "type": "int",
        "slider": {
            "min": 10,
            "max": 500,
            "step": 10
        },
        "default": 90
    },
    "source_max_minute": {
        "description": "资源最大时长（分钟）",
        "hint": "允许下载的音视频最大时长，超过则不解析",
        "type": "int",
        "slider": {
            "min": 1,
            "max": 60,
            "step": 1
        },
        "default": 15
    },
    "audio_to_file": {
        "description": "音频以文件形式上传",
        "hint": "是否将解析到的音频文件用文件形式上传，而不是语音形式",
        "type": "bool",
        "default": true
    },
    "single_heavy_render_card": {
        "description": "单条重媒体仍渲染卡片",
        "hint": "重媒体是指：视频、音频、文件。重媒体下载和发送较为耗时，有需者可以打开此开关让插件先渲染一个信息卡片发出来，追求简洁者请不要开启",
        "type": "bool",
        "default": false
    },
    "forward_threshold": {
        "description": "转发阈值",
        "hint": "硬性要求：解析生成的消息条数达到此阈值时，将消息合并转发",
        "type": "int",
        "slider": {
            "min": 0,
            "max": 10,
            "step": 1
        },
        "default": 2
    },
    "show_download_fail_tip": {
        "description": "提示下载失败项",
        "hint": "关闭后将不再发送与下载失败相关的提示（如“此项媒体下载失败”、“超过文件大小限制”等） B站下载/合并失败始终返回简短提示。",
        "type": "bool",
        "default": true
    },
    "download_timeout": {
        "description": "下载请求超时秒数",
        "hint": "下载视频、音频等较大文件时的请求超时时间，单位秒。 建议设置大一点，视频、音频较大时下载耗时较长",
        "type": "int",
        "slider": {
            "min": 10,
            "max": 600,
            "step": 10
        },
        "default": 280
    },
    "download_retry_times": {
        "description": "下载失败重试次数",
        "hint": "下载失败时，最多重试的次数",
        "type": "int",
        "slider": {
            "min": 0,
            "max": 5,
            "step": 1
        },
        "default": 2
    },
    "common_timeout": {
        "description": "普通请求超时时间",
        "hint": "普通请求超时时间，单位秒。用于一些普通的请求 ",
        "type": "int",
        "slider": {
            "min": 5,
            "max": 60,
            "step": 1
        },
        "default": 15
    },
    "proxy": {
        "description": "代理地址",
        "hint": "如 http://127.0.0.1:7890, 留空则直连。配置代理地址后, 请在各个解析器中再配置是否使用代理",
        "type": "string",
        "default": ""
    },
    "clean_cron": {
        "description": "自动清理缓存的触发周期",
        "hint": "使用 Cron 表达式（分 时 日 月 周）定义。例如：“30 2 * * *” 表示每天 2:30 。留空表示禁用自动清理",
        "type": "string",
        "default": "30 2 * * *"
    },
    "parsers_template": {
        "description": "解析器",
        "type": "template_list",
        "hint": "配置各个解析器, 没配置的解析器将不会被启用, 请勿添加相同的解析器",
        "templates": {
            "bilibili": {
                "name": "B站解析器",
                "items": {
                    "enable": {
                        "description": "启用",
                        "type": "bool",
                        "default": true
                    },
                    "use_proxy": {
                        "description": "使用代理",
                        "type": "bool",
                        "default": false
                    },
                    "cookies": {
                        "description": "Cookies",
                        "hint": "选填",
                        "type": "text",
                        "default": ""
                    },
                    "video_codec_list": {
                        "description": "B站视频编码",
                        "hint": "优先下载的编码类型，可选：AVC、AV1、HEV。失败时会按列表依次回退",
                        "type": "list",
                        "options": [
                            "AVC",
                            "AV1",
                            "HEV"
                        ],
                        "default": [
                            "AVC",
                            "AV1",
                            "HEV"
                        ]
                    },
                    "video_quality": {
                        "description": "B站视频分辨率",
                        "hint": "最高画质上限；仅选择 API 实际提供的流。未登录可能只有 480P，失败不会自动降画质。",
                        "type": "string",
                        "options": [
                            "_360P",
                            "_480P",
                            "_720P",
                            "_1080P",
                            "_1080P_PLUS",
                            "_1080P_60",
                            "_4K",
                            "HDR",
                            "DOLBY",
                            "_8K",
                            "AI_REPAIR"
                        ],
                        "labels": [
                            "360P 流畅",
                            "480P 标清",
                            "720P 高清",
                            "1080P 全高清",
                            "1080P+ 增强版",
                            "1080P 60帧",
                            "4K 超高清",
                            "HDR 高动态范围",
                            "杜比视界 Dolby Vision",
                            "8K 超高清",
                            "AI修复"
                        ],
                        "default": "_720P"
                    },
                    "block_pcdn": {
                        "description": "屏蔽 P/MCDN",
                        "hint": "排除已识别的 P/MCDN；全部被排除时明确报错，不回退到被屏蔽节点。",
                        "type": "bool",
                        "default": false
                    },
                    "api_client": {
                        "description": "B站 API 请求客户端",
                        "type": "string",
                        "default": "aiohttp",
                        "hint": "仅在专用子进程中生效，不改变其他插件的 bilibili-api 设置。",
                        "options": [
                            "aiohttp",
                            "httpx",
                            "curl_cffi"
                        ]
                    },
                    "api_user_agent": {
                        "description": "B站 API User-Agent",
                        "type": "string",
                        "default": "curl/8.14.1",
                        "hint": "此组合在部分 VPS 验证可用，不保证所有网络永久有效。"
                    },
                    "auto_buvid": {
                        "description": "B站自动获取 buvid",
                        "type": "bool",
                        "default": false,
                        "hint": "关闭以采用已验证的兼容配置；登录不是必须条件。"
                    },
                    "connect_timeout": {
                        "description": "B站 CDN 连接超时（秒）",
                        "type": "int",
                        "default": 15,
                        "hint": "TCP/TLS 连接等待上限。"
                    },
                    "read_timeout": {
                        "description": "B站 CDN 读取空闲超时（秒）",
                        "type": "int",
                        "default": 60,
                        "hint": "连续没有收到数据的时间；不是整个文件传输时间。"
                    },
                    "task_timeout": {
                        "description": "B站下载任务总上限（秒）",
                        "type": "int",
                        "default": 900,
                        "hint": "包括等待缓存锁、下载、退避、地址刷新、FFmpeg 合并。download_timeout 仍是单次请求上限，超时可从断点恢复。"
                    },
                    "partial_expire_hours": {
                        "description": "B站未完成下载保留小时数",
                        "type": "int",
                        "default": 24,
                        "hint": "启动时及每小时清理不活跃的过期 .part；过多残片也会被清理。"
                    },
                    "cache_expire_hours": {
                        "description": "B站完整缓存保留小时数",
                        "type": "int",
                        "default": 24,
                        "hint": "按最后使用时间清理，不复用旧版仅 BV 命名的缓存。"
                    }
                }
            },
